{
  "name": "stockoja-sales-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Local-only AI sales agent for StockỌja: discovers, qualifies and (later) contacts Nigerian merchants. Runs on your laptop only while you start it.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server/index.ts",
    "start": "npm run build:web && cross-env NODE_ENV=production tsx src/server/index.ts",
    "build:web": "vite build",
    "db:setup": "tsx scripts/db-setup.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "imapflow": "^1.0.191",
    "mailparser": "^3.7.4",
    "mammoth": "^1.13.0",
    "node-html-parser": "^9.0.5",
    "pg": "^8.23.1",
    "unpdf": "^1.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-vue": "^5.2.4",
    "cross-env": "^7.0.3",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4",
    "vue-tsc": "^2.2.12"
  }
}
