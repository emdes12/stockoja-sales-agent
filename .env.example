# StockỌja AI Sales Agent: local settings. Copy to `.env` and fill in. Never commit `.env`.

# ── Database (local PostgreSQL) ────────────────────────────────────────────────
# The agent's own database and login role, created by `npm run db:setup`.
DATABASE_URL=postgres://sales_agent:change-me@localhost:5432/stockoja_sales_agent
# Used only by the tests (wiped between runs). Leave empty to skip database tests.
DATABASE_URL_TEST=postgres://sales_agent:change-me@localhost:5432/stockoja_sales_agent_test
# Only needed once, by `npm run db:setup`, to create the role and databases above.
# A superuser on your local Postgres (e.g. postgres). Remove it from .env after setup.
ADMIN_DATABASE_URL=

# ── Dashboard ──────────────────────────────────────────────────────────────────
# The dashboard only listens on this machine.
PORT=6400

# ── Discovery ──────────────────────────────────────────────────────────────────
# Public Overpass (OpenStreetMap) endpoint. Free; keep requests polite.
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Sent as a contact in the User-Agent so OpenStreetMap and websites can reach you
# if the agent misbehaves. A business address is fine.
CONTACT_EMAIL=

# ── Email (stage 4) ────────────────────────────────────────────────────────────
# Sending stays in DRY RUN until you switch it to live in Settings (which also checks the domain is verified).
# Ideally a Resend key limited to "Sending access"; a full-access key also lets the agent detect bounces.
RESEND_API_KEY=
# An address on your outreach subdomain (verified in Resend). Keeps cold email away from stockoja.com's own
# reputation. The display name is your name from Settings.
OUTREACH_FROM_ADDRESS=hello@sales.stockoja.com
# A mailbox you actually read. The sending subdomain cannot receive mail, so replies (and STOP) go here.
OUTREACH_REPLY_TO=hello@stockoja.com

# ── Replies (stage 5) ──────────────────────────────────────────────────────────
# The mailbox that OUTREACH_REPLY_TO delivers to, read over IMAP in READ-ONLY mode (nothing is marked read,
# moved or deleted). Only mail related to your outreach (from a lead, or a reply to an outreach subject) is
# downloaded. Reading stays off until you turn it on in Settings.
# Use an app password (Gmail: Google Account → Security → App passwords; Zoho/Outlook have the same), never your
# main password. Gmail: imap.gmail.com · Zoho: imap.zoho.com · Outlook/Microsoft 365: outlook.office365.com
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX

# ── AI writing ──────────────────────────────────────────────────────────────────
# A Gemini API key from Google AI Studio (the free tier works). With it, outreach and answers are written by AI for
# each person (switch off in Settings → AI); every call is checked against the daily and monthly limits set there.
# On the free tier Google may use the data you send.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Backup models, comma-separated, tried in order when GEMINI_MODEL is busy (HTTP 503) or out of quota. Leave empty
# and the agent picks the newest Flash and Flash-Lite models your key can use, on the same key.
GEMINI_FALLBACK_MODELS=

# ── Meta app: Instagram lookup and the Instagram/Facebook inbox (optional) ─────
# Step-by-step in docs/META_SETUP.md. Uses StockỌja's own Facebook Page and its linked Instagram account through a
# Meta app you own (free). Each feature stays off until you switch it on in Settings → Instagram & Facebook.
# A long-lived Page access token. Treat it like a password.
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
# Recommended: calls then carry an appsecret_proof, so the token alone is not enough.
META_APP_SECRET=
# Optional: read from the Page when empty.
META_IG_USER_ID=
META_GRAPH_VERSION=v25.0

# ── Web search (optional): Discovery → Web search. Each provider is used only when its key is here AND it is
# ticked in Settings → Web search & groups (none, one or both). Monthly limits are set there too.
# Tavily: free plan, 1,000 credits a month, no card (tavily.com).
TAVILY_API_KEY=
# Brave Search API: about $5 per 1,000 searches with a $5 monthly credit; needs a card and has no spending cap of its own.
BRAVE_SEARCH_API_KEY=

# ── Telegram bot (optional): Inbox → Telegram ─────────────────────────────────────
# Create a bot with @BotFather in Telegram (free) and paste its token here. People who message the bot appear in
# the Inbox; answers go back through the bot after approval. Treat the token like a password.
TELEGRAM_BOT_TOKEN=
